<!DOCTYPE html>
<html lang="{{ Culture.Name }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    {% link rel:"manifest", href:"./app.webmanifest" %}

    <title>{{ "PageTitle" | shape_new | shape_stringify }}</title>
    {% resources type: "Meta" %}
    {% link type:"image/x-icon", rel:"shortcut icon", href:"~/TheBlogTheme/favicon.ico" %}
    <!-- Font Awesome icons (free version)-->
    {% style name:"font-awesome", version:"7", at:"Head" %}
    <!-- Google fonts -->
    <link href='https://fonts.googleapis.com/css?family=Lora:400,700,400italic,700italic' rel='stylesheet' type='text/css'>
    <link href='https://fonts.googleapis.com/css?family=Open+Sans:300italic,400italic,600italic,700italic,800italic,400,300,600,700,800' rel='stylesheet' type='text/css'>
    <!-- Core theme CSS (includes Bootstrap) -->
    {% style name:"theblogtheme" %}
    {% style name:"theblogtheme-bootstrap-oc", version:"1" %}
    {% script name:"theblogtheme", at:"Foot" %}

    <script src="./webpush/sdk/OneSignalSDK.page.js" defer></script>
    <script type="module">
      const response = await fetch("./webpush/identity");

      window.OneSignalDeferred = window.OneSignalDeferred || [];
      OneSignalDeferred.push(async function(OneSignal) {
        await OneSignal.init({
          appId: "0ce6b8ef-f16f-44c8-bd56-b6057d734110",
        });

        if (response.status === 200) {
            const identity = await response.json();
            console.log("Web Push Identity:", identity);
            //await OneSignal.login(identity.userId, "");
            console.log("Web Push Identity:", identity);
        } else {
            console.error("Failed to fetch Web Push Identity:", response.status, response.statusText);
        }
      });
    </script>

    {% resources type: "HeadScript" %}
    {% resources type: "HeadLink" %}
    {% resources type: "Stylesheet" %}
    {% render_section "HeadMeta", required: false %}
</head>
<body dir="{{ Culture.Dir }}">
    <nav class="navbar navbar-expand-lg navbar-light" id="mainNav">
        <div class="container px-4 px-lg-5">
            <a class="navbar-brand" href="{{ '~/' | href }}">{{ Site.SiteName }}</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarResponsive" aria-controls="navbarResponsive" aria-expanded="false" aria-label="Toggle navigation">
                <span class="visually-hidden">{{ "Toggle navigation" | t }}</span>
                {{ "Menu" | t }} <i class="fa fa-bars" aria-hidden="true"></i>
            </button>
            {% shape "menu", alias: "alias:main-menu", cache_id: "main-menu", cache_fixed_duration: "00:05:00", cache_tag: "alias:main-menu", cache_context: "user.roles" %}
        </div>
    </nav>
    {% render_section "Header", required: false %}
    <div class="container px-4 px-lg-5 mb-4">
        <div class="row gx-4 gx-lg-5 justify-content-center">
            <div class="col-md-10 col-lg-8 col-xl-7">
				{% render_section "Messages", required: false %}
                {% render_body %}
            </div>
        </div>
    </div>
    <footer class="border-top">
        {% render_section "Footer", required: false %}
        <button id="checkButton">Check Notification Support</button>
        <div id="result"></div>
        <button id="enableNotifButton">Enable Notifications</button>
        <button id="oneSignalLogin">OneSignalLogin</button>
        <button id="oneSignalLogout">OneSignalLogout</button>
    </footer>
    {% resources type: "FootScript" %}
    <script>
    function isNotificationSupported() {
      // Check for basic Notification API support
      if (!("Notification" in window)) {
        return false;
      }

      // Check for Service Worker + Push API support (required for Web Push)
      if (
        !("serviceWorker" in navigator) ||
        !("PushManager" in window) ||
        !("showNotification" in ServiceWorkerRegistration.prototype)
      ) {
        return false;
      }

      // Optional: Check if the browser has disabled notifications (e.g., Firefox "alerts" restriction)
      try {
        if (Notification.permission === "denied" && !Notification.maxActions) {
          return false; // Browser blocks notifications entirely
        }
      } catch (e) {
        console.warn("Notification permission check failed:", e);
      }

      return true;
    }

    async function registerAndSubscribe() {
        try {
            // Register service worker
            await navigator.serviceWorker.register("./notification-sw.js");
        
            // Wait for service worker to be ready
            const registration = await navigator.serviceWorker.ready;

            const serverPublicKeyAsUrlSafeBase64 = await (await fetch('/webpush/public-key')).text();

            const existingSubscription = await registration.pushManager.getSubscription();
    
            if (existingSubscription) {
              console.log('Already subscribed:', existingSubscription);

              const publicKey = existingSubscription.getKey('p256dh');

              if (publicKey == serverPublicKeyAsUrlSafeBase64)
                return existingSubscription;
            }

            // Subscribe to push notifications
            const newSubscription = await registration.pushManager.subscribe({
                userVisibleOnly: true,
                //applicationServerKey: btoa(serverPublicKey),
                applicationServerKey: serverPublicKeyAsUrlSafeBase64,
            });

            const requestBody = JSON.stringify(newSubscription.toJSON());
            const response = await fetch('/webpush/subscriptions', {
              method: 'POST', // The HTTP method
              headers: {
                'Content-Type': 'application/json'
              },
              body: requestBody
            });

            console.info("Created subscription Object: ", newSubscription.toJSON());
            return newSubscription;
        
        } catch (error) {
            console.error("Subscription failed:", error);
            throw new Error(`Failed to register and subscribe: ${error.message}`);
        }
    }

    document.getElementById('checkButton').addEventListener('click', () => {
            const supported = isNotificationSupported();
            const resultElement = document.getElementById('result');
            
            if (supported) {
                resultElement.textContent = '🎉 This browser supports notifications!';
                resultElement.className = 'supported';
            } else {
                resultElement.textContent = '❌ This browser does NOT support notifications.';
                resultElement.className = 'unsupported';
            }

            //showResultNotification(supported);
        });

     document.getElementById('enableNotifButton').addEventListener('click', async () => {
        try {
            const subscription = await registerAndSubscribe();
            console.log('Subscription successful:', subscription);
            // You can add success UI updates here
        } catch (error) {
            console.error('Subscription failed:', error);
            // You can add error UI handling here
        }
        });

     document.getElementById('oneSignalLogin').addEventListener('click', async () => {
                const response = await fetch("./webpush/identity");

              window.OneSignalDeferred = window.OneSignalDeferred || [];
              OneSignalDeferred.push(async function(OneSignal) {

                if (response.status === 200) {
                    const identity = await response.json();
                    console.log("Web Push Identity:", identity);
                    await OneSignal.login(
                        identity.userId,
                        "",
                    );
                    console.log("Web Push Identity:", identity);
                } else {
                    console.error("Failed to fetch Web Push Identity:", response.status, response.statusText);
                }
              });
        });

        document.getElementById('oneSignalLogout').addEventListener('click', async () => {

              window.OneSignalDeferred = window.OneSignalDeferred || [];
              OneSignalDeferred.push(async function(OneSignal) {

                await OneSignal.logout();
              });
        });
</script>
</body>
</html>